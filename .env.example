# =============================================================================
# Net Dealer Target ("C") calculator — configuration
# Copy to `.env` and fill in. Anything blank falls back to a safe default.
# =============================================================================

# ----- Data mode -------------------------------------------------------------
# "live" -> pull real chains from Schwab using the SHARED token below (default).
# "mock" -> synthetic option chain, no network (offline/CI/demo only).
DATA_MODE=live

# Ticker dropdown. Leave BLANK to use the full bundled S&P 500 + Nasdaq-100
# universe (~517 symbols). The UI search box also accepts any symbol Schwab
# knows. Set a comma-separated list only to pin a custom watchlist, e.g.:
# TICKERS=MU,SPY,QQQ,NVDA,TSLA
TICKERS=

# ----- Shared Schwab token (identical mechanism to the 0DTE / MM services) ---
# This app holds NO Schwab credentials. It fetches a short-lived access token
# over HTTP from the MM token endpoint and uses it to read option chains.
#
#   GET <SCHWAB_TOKEN_URL>  Authorization: Bearer <SCHWAB_TOKEN_SHARE_KEY>
#   -> { "access_token": "...", "expires_in": 1800 }
SCHWAB_AUTH_MODE=shared
# Token endpoint. Leave blank to default to MM_BASE_URL + /auth/token.
SCHWAB_TOKEN_URL=https://web-production-fff5c.up.railway.app/auth/token
# Bearer key presented to the token endpoint (== MM's SCHWAB_TOKEN_SHARE_KEY).
# Falls back to MM_API_KEY if blank. REQUIRED for DATA_MODE=live.
SCHWAB_TOKEN_SHARE_KEY=

# MM service (source of the token endpoint + share-key fallback).
MM_BASE_URL=https://web-production-fff5c.up.railway.app
MM_API_KEY=

# Schwab market-data base (rarely changed).
SCHWAB_BASE_URL=https://api.schwabapi.com

# ----- Net-dealer model knobs -----------------------------------------------
RISK_FREE_RATE=0.043     # annual rate used in the Black-Scholes delta
FALLBACK_IV=0.40         # IV used when a strike lists none
STRIKE_COUNT=80          # strikes (around the money) to pull per expiry
EXPIRY_HORIZON_DAYS=60   # how far out to list expirations

# ----- Opportunity scanner ---------------------------------------------------
# The scanner sweeps a curated set of liquid names and ranks them by projected
# option %-gain if price pins to C by the nearest weekly.
# Leave SCAN_TICKERS blank to use the bundled ~50-name LIQUID list, or set a
# comma-separated watchlist, e.g. SCAN_TICKERS=SPY,QQQ,NVDA,TSLA,AAPL
SCAN_TICKERS=
SCAN_MIN_OI=100          # a candidate contract needs at least this open interest
SCAN_MIN_ASK=0.10        # ...and at least this ask (keeps penny strikes out)
SCAN_MIN_EDGE_PCT=0.002  # ignore tickers whose C is within this % of spot
SCAN_MIN_GAIN_PCT=0.10   # a ranked opportunity must project at least +10%
SCAN_MAX_GAIN_PCT=20.0   # cap the projected gain shown (guards stale/penny asks)
SCAN_WITHIN_DAYS=9       # "nearest weekly" search window
SCAN_WORKERS=8           # concurrent chain fetches during a scan
SCAN_CACHE_SECONDS=60    # serve the last scan from cache for this long

# ----- Web -------------------------------------------------------------------
# Origins allowed to call the API (set to your GitHub Pages URL if the static
# front-end is hosted separately from this backend). "*" allows any origin.
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8080
